# NeuralNode Environment Configuration
# Copy this file to .env and fill in your API keys

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google (Gemini) Configuration
GOOGLE_API_KEY=your-google-api-key-here

# Ollama Configuration (for local models)
# No API key needed, just ensure Ollama is running
OLLAMA_BASE_URL=http://localhost:11434

# Horus Cyber Nano 1.0 BETA Early Access
HORUS_CYPER_NANO_API_KEY=horusNN-your-access-token
HORUS_CYPER_NANO_BASE_URL=https://api.tokenai.llc/v1

# NeuralNode H-Preview API Gateway
NEURALNODE_API_DB=neuralnode-api.sqlite3
NEURALNODE_API_KEY=nn-your-24-character-token
NEURALNODE_API_BASE_URL=http://127.0.0.1:8000/v1
H_PREVIEW_UPSTREAM_URL=http://127.0.0.1:8001/v1
H_PREVIEW_UPSTREAM_MODEL=DavidAU/Qwen3.8-27B-TURBO-Fable-Cold-Fusion-735-882-Heretic-Uncensored-NM-DAU
# Optional: only set this when the remote model server requires an API key.
# H_PREVIEW_UPSTREAM_API_KEY=

# NeuralNode Settings
NEURALNODE_DEFAULT_PROVIDER=auto
NEURALNODE_MEMORY_ENABLED=true
NEURALNODE_SAFE_MODE=true
NEURALNODE_LOG_LEVEL=INFO
