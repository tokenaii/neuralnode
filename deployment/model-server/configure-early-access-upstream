#!/usr/bin/env bash
set -euo pipefail

env_file="${1:-/opt/tokenai-early-access/.env}"
secret_file="${2:-/tmp/horus-cyber-model.env}"

source "$secret_file"
: "${MODEL_INTERNAL_API_KEY:?MODEL_INTERNAL_API_KEY is required}"

temp_file="$(mktemp "${env_file}.XXXXXX")"
trap 'rm -f "$temp_file"' EXIT

grep -vE '^MODEL_UPSTREAM_(URLS|MODEL|MODE|API_KEY|TIMEOUT_MS)=' "$env_file" > "$temp_file" || true
printf '%s\n' \
  'MODEL_UPSTREAM_URLS=http://host.docker.internal:18011/v1,http://host.docker.internal:18012/v1' \
  'MODEL_UPSTREAM_MODEL=horus-cyber-nano-1.0-beta' \
  'MODEL_UPSTREAM_MODE=completion' \
  "MODEL_UPSTREAM_API_KEY=${MODEL_INTERNAL_API_KEY}" \
  'MODEL_UPSTREAM_TIMEOUT_MS=180000' >> "$temp_file"

chmod 600 "$temp_file"
mv "$temp_file" "$env_file"
trap - EXIT
